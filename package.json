{
	"name": "react-template",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"bin": "./dist/index.js",
	"scripts": {
		"dev": "cross-env NODE_ENV=development node --loader ts-node/esm ./src/index.ts",
		"dev-watch": "cross-env NODE_ENV=development nodemon --config nodemon.json ./src/index.ts",
		"dev-brk": "cross-env NODE_ENV=development node --inspect-brk=0.0.0.0:9229 --loader ts-node/esm ./src/index.ts",
		"tslint": "npx tsc --noEmit",
		"eslint": "npx eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0 --fix",
		"lint": "npm run eslint && npm run tslint"
	},
	"devDependencies": {
		"@types/adm-zip": "^0.5.5",
		"@types/copyfiles": "^2.4.1",
		"@types/node": "^20.8.3",
		"@types/qs": "^6.9.15",
		"@typescript-eslint/eslint-plugin": "^6.7.4",
		"@typescript-eslint/parser": "^6.7.4",
		"@vercel/ncc": "^0.38.0",
		"copyfiles": "^2.4.1",
		"cross-env": "^7.0.3",
		"eslint": "^7.32.0",
		"nodemon": "^3.0.1",
		"prettier": "^3.0.3",
		"rimraf": "^5.0.5",
		"ts-node": "^10.9.1",
		"typescript": "^5.2.2"
	},
	"dependencies": {
		"adm-zip": "^0.5.13",
		"chalk": "^5.3.0",
		"dayjs": "^1.11.11",
		"form-data": "^4.0.0",
		"got": "^13.0.0",
		"hpagent": "^1.2.0",
		"qs": "^6.12.1",
		"yaml": "^2.4.3"
	}
}
