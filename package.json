{
    "private": true,
    "name": "monorepo",
    "version": "0.0.1",
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "dev:demo": "npx pnpm -r --filter demo run dev",
        "build:demo": "npx pnpm -r --filter demo run build",
        "lint": "npx pnpm -r --filter=\"*\" run lint",
        "rm-dep": "npx rimraf ./node_modules && npx pnpm -r --filter=\"*\" run rm-dep",
        "prettier": "npx prettier **/* --write --ignore-unknown",
        "check-updates": "npx npm-check-updates -ws"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^7.5.0",
        "@typescript-eslint/parser": "^7.5.0",
        "eslint": "^8.56.0",
        "eslint-plugin-import": "^2.29.1",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-react-refresh": "^0.4.6",
        "npm-check-updates": "^16.14.18",
        "prettier": "^3.2.5",
        "typescript": "^5.4.4"
    }
}
