{
    "private": true,
    "name": "demo",
    "version": "2.4.3",
    "type": "module",
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "dev": "npx vite",
        "build": "npx vite build",
        "preview": "npx vite preview",
        "tslint": "npx tsc --noEmit",
        "eslint": "npx eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0 --fix",
        "lint": "npm run eslint && npm run tslint",
        "rm-dep": "npx rimraf ./node_modules"
    },
    "peerDependencies": {
        "@react/components": "workspace:*",
        "@react/hooks": "workspace:*",
        "@react/utils": "workspace:*"
    },
    "dependencies": {
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-router-dom": "^6.22.2"
    },
    "devDependencies": {
        "@types/react": "^18.2.64",
        "@types/react-dom": "^18.2.21",
        "@vitejs/plugin-react-swc": "^3.6.0",
        "vite": "^5.1.5"
    }
}
